# нормализация переводов строк
* text=auto

# исходники и скрипты Windows - CRLF
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.manifest text eol=crlf

# бинарники не трогаем
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.ttf binary
*.exe binary
