<Window x:Class="VividDesk.Views.WallpaperSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VividDesk.Views"
        Title="Настройки обоев — Lume" Height="570" Width="390"
        MinHeight="420" MinWidth="345"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BgBrush}">
    <WindowChrome.WindowChrome>
        <!-- безшовное окно: перетаскивание за карточку превью, родной ресайз.
             Контент масштабирован 0.75, поэтому caption и рамка ресайза пропорциональны -->
        <WindowChrome CaptionHeight="188" ResizeBorderThickness="5" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <DockPanel x:Name="RootPanel">
        <DockPanel.LayoutTransform>
            <ScaleTransform x:Name="WndScale" ScaleX="0.75" ScaleY="0.75"/>
        </DockPanel.LayoutTransform>
        <!-- превью и информация -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="14"
                BorderBrush="{StaticResource GlassEdgeBrush}" BorderThickness="1"
                CornerRadius="16" Margin="14,14,14,0">
            <Grid>
                <StackPanel>
                <Border Height="170" CornerRadius="10" Background="{StaticResource ThumbBgBrush}" ClipToBounds="True">
                    <Image x:Name="PreviewImg" Stretch="UniformToFill" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Margin="0,10,0,0"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="TypeText" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="BtnMinWindow" Style="{StaticResource CaptionMinimizeButton}" Click="BtnMinWindow_Click"/>
                    <Button x:Name="BtnCloseWindow" Style="{StaticResource CaptionCloseButton}" Margin="4,0,0,0" Click="BtnCloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- выбор монитора и применение -->
        <Border DockPanel.Dock="Bottom" Padding="14,10" CornerRadius="16" Margin="14,10,14,14"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GlassEdgeBrush}"
                BorderThickness="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnOpenProjectFolder" Content="📂 Папка обои" Margin="0,0,8,0"
                            Click="BtnOpenProjectFolder_Click"/>
                    <Button x:Name="BtnApply" Content="Применить на монитор" MinWidth="170"
                            FontWeight="SemiBold" Click="BtnApply_Click"/>
                </StackPanel>
                <ComboBox x:Name="MonitorCombo" Width="210" VerticalAlignment="Center"
                          SelectionChanged="MonitorCombo_SelectionChanged"/>
            </DockPanel>
        </Border>

        <!-- все свойства и регулировки (переиспользуемая панель) -->
        <local:WallpaperSettingsPanel x:Name="Panel"/>
    </DockPanel>
</Window>
