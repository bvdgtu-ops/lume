<Window x:Class="VividDesk.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Lume — живые обои" Height="540" Width="885"
        MinHeight="420" MinWidth="705"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BgBrush}"
        AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver">
    <WindowChrome.WindowChrome>
        <!-- безшовное окно: перетаскивание за тулбар, родной ресайз и снап без рамки ОС.
             Контент масштабирован 0.5, поэтому caption и рамка ресайза тоже вдвое меньше -->
        <WindowChrome CaptionHeight="51" ResizeBorderThickness="5" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.75" ScaleY="0.75"/>
        </Grid.LayoutTransform>
        <!-- ======================= AURORA-ФОН (стекло читается на цвете) ======================= -->
        <Grid IsHitTestVisible="False">
            <Ellipse Width="680" Height="680" Fill="{StaticResource AuroraViolet}"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-170,-190,0,0"/>
            <Ellipse Width="640" Height="640" Fill="{StaticResource AuroraCyan}"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-160,-200"/>
            <Ellipse Width="560" Height="560" Fill="{StaticResource AuroraMagenta}"
                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-220,-120,0"/>
        </Grid>

        <DockPanel>
            <!-- ======================= ПАНЕЛЬ ИНСТРУМЕНТОВ ======================= -->
            <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="16,10"
                    BorderBrush="{StaticResource GlassEdgeBrush}" BorderThickness="1"
                    CornerRadius="16" Margin="14,14,14,0">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Lume" FontSize="19" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBlock x:Name="SubTitleText" Text="живые обои для Windows" FontSize="13"
                                   Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Bottom" Margin="0,0,24,1"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnAddFile" Content="＋ Добавить свои обои" Margin="0,0,8,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnAddFile_Click"/>
                        <Button x:Name="BtnAddUrl" Content="🌐 Веб-обои по URL" Margin="0,0,8,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnAddUrl_Click"/>
                        <Button x:Name="BtnWallpaperSettings" Content="🛠 Настройки обоев" Margin="0,0,8,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnWallpaperSettings_Click"/>
                        <Button x:Name="BtnPresets" Content="📦 Пресеты" Margin="0,0,8,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnPresets_Click"/>
                        <Button x:Name="BtnSettings" Content="⚙ Настройки" Margin="0,0,8,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="BtnSettings_Click"/>
                        <Border Width="1" Height="22" Background="{StaticResource BorderBrush1}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                        <Button x:Name="BtnMinWindow" Style="{StaticResource CaptionMinimizeButton}" Click="BtnMinWindow_Click"/>
                        <Button x:Name="BtnMaxWindow" Style="{StaticResource CaptionMaximizeButton}" Margin="2,0,0,0" Click="BtnMaxWindow_Click"/>
                        <Button x:Name="BtnCloseWindow" Style="{StaticResource CaptionCloseButton}" Margin="8,0,0,0" Click="BtnCloseWindow_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ======================= ВЫБОР МОНИТОРА ======================= -->
            <Border DockPanel.Dock="Top" Padding="16,8" CornerRadius="14" Margin="14,10,14,0"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GlassEdgeBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="MonitorLabel" Text="Монитор:" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{StaticResource TextDimBrush}"/>
                    <StackPanel x:Name="MonitorBar" Orientation="Horizontal"/>
                    <Button x:Name="BtnClearMonitor" Content="Убрать обои" Margin="12,0,0,0" Padding="8,4"
                            Click="BtnClearMonitor_Click" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ======================= СТАТУСНАЯ СТРОКА ======================= -->
            <Border DockPanel.Dock="Bottom" Padding="16,8" CornerRadius="14" Margin="14,10,14,14"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GlassEdgeBrush}"
                    BorderThickness="1">
                <DockPanel>
                    <Button x:Name="BtnOpenFolder" Content="📂 Открыть папку обоев" DockPanel.Dock="Right"
                            Padding="8,3" FontSize="12" Click="BtnOpenFolder_Click"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- ======================= БИБЛИОТЕКА ======================= -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="WallList" Background="Transparent" BorderThickness="0"
                             Padding="14,12,8,12" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="WallList_SelectionChanged"
                             MouseDoubleClick="WallList_MouseDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="12"
                                                    BorderBrush="Transparent" BorderThickness="1"
                                                    Margin="6" Padding="6">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource GlassHoverBrush}"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource GlassSelectedBrush}"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu Background="{StaticResource GlassPopupBrush}"
                                                     Foreground="{StaticResource TextBrush}">
                                            <!-- Header задаёт текст; Click routed-событие ловится в code-behind
                                                 (обработчики событий внутри Setter.Value не поддерживаются) -->
                                            <MenuItem Header="Настроить…" Tag="settings"/>
                                            <MenuItem Header="Удалить из библиотеки" Tag="delete"/>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,4">
                                    <Border CornerRadius="10" Background="{StaticResource ThumbBgBrush}" ClipToBounds="True" Height="118">
                                        <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis" Margin="4,7,4,0"/>
                                    <TextBlock Text="{Binding TypeLabel}" FontSize="11"
                                               Foreground="{StaticResource TextDimBrush}" Margin="4,2,4,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
