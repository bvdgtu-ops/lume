<Window x:Class="VividDesk.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки Lume" Height="480" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        FontFamily="{StaticResource AppFont}"
        Background="{StaticResource BgBrush}">
    <WindowChrome.WindowChrome>
        <!-- безшовное окно: перетаскивание за шапку-карточку. Контент масштабирован 0.75 -->
        <WindowChrome CaptionHeight="45" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <DockPanel x:Name="RootPanel">
        <DockPanel.LayoutTransform>
            <ScaleTransform x:Name="WndScale" ScaleX="0.75" ScaleY="0.75"/>
        </DockPanel.LayoutTransform>
        <Border DockPanel.Dock="Top" Height="46" Margin="14,14,14,0" CornerRadius="14"
                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GlassEdgeBrush}"
                BorderThickness="1">
            <DockPanel Margin="12,0,8,0">
                <Button x:Name="BtnCloseWindow" DockPanel.Dock="Right" VerticalAlignment="Center"
                        Style="{StaticResource CaptionCloseButton}" Click="BtnClose_Click"/>
                <TextBlock x:Name="HeaderText" Text="Настройки Lume" FontSize="15" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
            </DockPanel>
        </Border>

        <DockPanel Margin="16,12,16,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnSave" Content="Сохранить" MinWidth="100" Margin="0,0,8,0" Click="BtnSave_Click"/>
            <Button x:Name="BtnCancel" Content="Отмена" MinWidth="100" Click="BtnCancel_Click"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="LblHeader" Text="Настройки приложения" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock x:Name="LblSound" Text="Звук" FontWeight="Bold" Margin="0,6,0,4"/>
                <CheckBox x:Name="ChkSound" Content="Разрешить звук обоев (видео и веб-страниц)" Margin="0,2,0,6"/>

                <TextBlock x:Name="LblBehavior" Text="Поведение" FontWeight="Bold" Margin="0,10,0,4"/>
                <CheckBox x:Name="ChkAutoPause" Content="Авто-пауза в полноэкранных приложениях (игры, видео)" Margin="0,2,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                    <TextBlock x:Name="LblWhenPaused" Text="При паузе:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbPauseAction" Width="220">
                        <ComboBoxItem x:Name="ItmPauseFreeze" Content="Стоп-кадр (пауза)" Tag="pause"/>
                        <ComboBoxItem x:Name="ItmPauseStop" Content="Полная остановка (максимальная экономия)" Tag="stop"/>
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="ChkAudioCapture" Content="Захватывать системный звук для аудио-визуализаторов" Margin="0,2,0,6"/>

                <TextBlock x:Name="LblSystem" Text="Система" FontWeight="Bold" Margin="0,10,0,4"/>
                <CheckBox x:Name="ChkAutoStart" Content="Запускать Lume вместе с Windows" Margin="0,2,0,6"/>
                <CheckBox x:Name="ChkStartMinimized" Content="Запускать свёрнутым в трей" Margin="0,2,0,6"/>
                    <CheckBox x:Name="ChkLockScreen" Content="Ставить кадр обоев на экран блокировки" Margin="0,2,0,6"/>
                    <CheckBox x:Name="ChkLiveLock" Content="Живая заставка по бездействию (анимация вместо статичного кадра)" Margin="0,4,0,2"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock x:Name="LblLiveLockMin" Text="Через, минут:" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                        <TextBox x:Name="TxtLiveLockMin" Width="56" Padding="6,3" FontSize="12"/>
                    </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                    <TextBlock x:Name="LblLanguage" Text="Язык / Language:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbLanguage" Width="140" SelectionChanged="CmbLanguage_SelectionChanged">
                        <ComboBoxItem Content="Русский" Tag="ru"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                    <TextBlock x:Name="LblUiScale" Text="Размер интерфейса:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="SldUiScale" Width="150" Minimum="40" Maximum="100" Value="75"
                            SmallChange="1" LargeChange="10"
                            VerticalAlignment="Center" ValueChanged="SldUiScale_ValueChanged"/>
                    <TextBlock x:Name="LblScaleValue" Text="75%" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="42"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                    <TextBlock x:Name="LblWallScale" Text="Масштаб обоев:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="SldWallScale" Width="150" Minimum="50" Maximum="150" Value="100"
                            SmallChange="5" LargeChange="10"
                            VerticalAlignment="Center" ValueChanged="SldWallScale_ValueChanged"/>
                    <TextBlock x:Name="LblWallScaleValue" Text="100%" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="42"/>
                </StackPanel>

                <TextBlock x:Name="LblDir" Text="Папка обоев" FontWeight="Bold" Margin="0,10,0,4"/>
                <DockPanel Margin="0,2,0,6">
                    <Button x:Name="BtnChangeDir" Content="Сменить…" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BtnChangeDir_Click"/>
                    <TextBox x:Name="TxtDir" IsReadOnly="True"/>
                </DockPanel>
                <Button x:Name="BtnOpenDir" Content="Открыть папку в проводнике" HorizontalAlignment="Left"
                        Padding="8,3" Click="BtnOpenDir_Click"/>

                <Separator Margin="0,14,0,10"/>
                <TextBlock x:Name="LblPlaylist" Text="Плейлист — автосмена обоев" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkPlaylist" Content="Включить автоматическую смену обоев" Margin="0,2,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                    <TextBlock x:Name="LblEvery" Text="Менять каждые:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtInterval" Width="48" Padding="4,3"/>
                    <TextBlock x:Name="LblMin" Text="мин." VerticalAlignment="Center" Margin="6,0,16,0"/>
                    <TextBlock x:Name="LblOrder" Text="Порядок:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbOrder" Width="160">
                        <ComboBoxItem x:Name="ItmOrderSeq" Content="По порядку" Tag="sequential"/>
                        <ComboBoxItem x:Name="ItmOrderRnd" Content="Случайно" Tag="random"/>
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="ChkSchedule" Content="Работать только по расписанию" Margin="0,2,0,4"/>
                <StackPanel Orientation="Horizontal" Margin="18,2,0,6">
                    <TextBlock x:Name="LblFrom" Text="с" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtFrom" Width="52" Padding="4,3"/>
                    <TextBlock x:Name="LblTo" Text="до" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox x:Name="TxtTo" Width="52" Padding="4,3"/>
                    <TextBlock x:Name="LblHint" Text="(ЧЧ:ММ)" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.55"/>
                </StackPanel>
                <TextBlock x:Name="LblPlaylistItems" Text="Обои в плейлисте:" Margin="0,6,0,4"/>
                <Border BorderBrush="{StaticResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="12"
                        MaxHeight="180" Background="{StaticResource FieldBrush}" Padding="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PlaylistPanel" Margin="8"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </DockPanel>
    </DockPanel>
</Window>
