<Window x:Class="LumeUninstall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удаление Lume" Height="330" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FF0B0D16">
    <Window.Resources>
        <LinearGradientBrush x:Key="Edge" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#59FFFFFF" Offset="0"/>
            <GradientStop Color="#0DFFFFFF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Text" Color="#FFEAECF5"/>
        <SolidColorBrush x:Key="Dim" Color="#FF9AA0B8"/>
        <SolidColorBrush x:Key="Accent" Color="#FF7C5CFF"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0FFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF7C5CFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF8D70FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Height" Value="8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Image x:Name="ImgLogo" Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Center"/>
            <TextBlock x:Name="LblTitle" Text="Удаление Lume" FontSize="21" FontWeight="Bold"
                       Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock x:Name="LblConfirm" Grid.Row="1" Text="Удалить Lume с этого компьютера?"
                   TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock x:Name="LblPath" Grid.Row="2" Foreground="{StaticResource Dim}" FontSize="12"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
        <CheckBox x:Name="ChkData" Grid.Row="3" VerticalAlignment="Top"
                  Content="Также удалить настройки и обои (библиотеку)"/>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <ProgressBar x:Name="Pbar" IsIndeterminate="True" Height="8"/>
            <TextBlock x:Name="LblStatus" Foreground="{StaticResource Dim}" FontSize="12" Margin="1,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnRemove" Content="Удалить" Style="{StaticResource AccentButton}"
                    MinWidth="130" Margin="0,0,8,0" Click="BtnRemove_Click"/>
            <Button x:Name="BtnCancel" Content="Отмена" MinWidth="90" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
